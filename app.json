{
  "expo": {
    "name": "n3ws",
    "slug": "n3ws",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aderiushev.n3ws",
      "appleTeamId": "32RFJTG8M6",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "cover",
        "backgroundColor": "#000000"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.aderiushev.n3ws"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "cover",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aderushev.n3ws"
    },
    "updates": {
      "url": "https://u.expo.dev/156cb513-ca6c-4034-96f2-5831735318cd"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },

    "plugins": [
      "expo-font",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0a7ea4",
          "sounds": [],
          "mode": "production"
        }
      ],
      "@bacons/apple-targets"
    ],
    "extra": {
      "eas": {
        "projectId": "156cb513-ca6c-4034-96f2-5831735318cd",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.aderiushev.n3ws.N3WSWidget",
                  "targetName": "N3WSWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.com.aderiushev.n3ws"]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "aderushev"
  }
}
